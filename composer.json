{
    "name": "umer936/cakephp-to-static",
    "description": "Static-readiness analysis, setup wizard, and safe public-page export for CakePHP 5.",
    "type": "cakephp-plugin",
    "license": "Unlicense",
    "require": {
        "php": ">=8.1",
        "ext-dom": "*",
        "ext-json": "*",
        "cakephp/cakephp": "^5.0",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "CakephpToStatic\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CakephpToStatic\\Test\\": "tests/"
        }
    },
    "extra": {
        "cakephp": {
            "name": "CakephpToStatic"
        }
    },
    "scripts": {
        "test": "phpunit",
        "check": "composer validate --strict && phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
